                    <div className="space-y-3 p-4 bg-white rounded-2xl border border-black/5 text-xs">
                      <div className="flex items-center gap-2">
                        <Palette className="w-4 h-4 text-[#B7102A]" />
                        <span className="font-bold text-black/40">재료:</span>
