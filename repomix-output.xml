                  value={userNote}
                  onChange={(e) => setUserNote(e.target.value)}
                  className="w-full px-3.5 py-2.5 bg-white border border-[#E6E2DC] rounded-xl text-xs text-[#1C1C18] focus:outline-hidden focus:border-[#B7102A]"
                ></textarea>
              </div>

              {/* Submit Button */}
              <div className="pt-2">
                <button
                  type="submit"
