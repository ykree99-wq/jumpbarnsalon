        </header>

        {/* Gallery Works Grid Layout */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10">
          {galleryWorks.map((work, index) => (
            <motion.div
              key={work.id}
