              <div className="space-y-4">
                {/* Header Rating & Date */}
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-1 text-[#D99B00]">
                    {[...Array(review.rating)].map((_, i) => (
                      <Star key={i} className="w-4 h-4 fill-current" />
