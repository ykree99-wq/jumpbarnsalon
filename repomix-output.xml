                {/* Structured Caption & Metadata Form */}
                <div className="p-6 sm:p-7 space-y-5">
                  {/* Header & Title */}
                  <div className="space-y-1">
                    <span className="text-[10px] font-black tracking-widest text-[#B7102A] uppercase block">
